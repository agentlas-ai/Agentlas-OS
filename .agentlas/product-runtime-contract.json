{
  "schema": "agentlas.product-runtime-contract.v1",
  "one": {
    "soleController": true,
    "turnTargets": "subagent-one-turn-only",
    "omittedOverrides": "controller-judges",
    "autonomousToolsAndSubagents": true
  },
  "work": {
    "entry": "project",
    "controller": "first-ordered-project-agent",
    "workerSelection": "task-workorder-verified",
    "persistentProjectFields": ["source", "system-prompt", "memory", "ordered-agent-pool", "orchestrator-model-priority", "worker-model-priority"]
  },
  "recovery": {
    "rawEvidenceVisibility": "private",
    "decisionOwner": "controller-llm",
    "requiredStages": ["judge", "safe-action", "verify", "present"],
    "dynamicPresentation": ["explanation", "cta", "question"]
  },
  "mobile": {
    "menus": ["one", "project-work", "automation"],
    "authority": "projection-only",
    "rawRecoveryEvidence": "never-render"
  },
  "prohibited": ["global-chat", "agent-group", "persistent-session-agent-switch", "default-agent-substitution", "semantic-fallback", "lexical-scoring", "regex-task-routing", "keyword-list-routing", "glossary-routing", "static-failure-copy-catalog"]
}
