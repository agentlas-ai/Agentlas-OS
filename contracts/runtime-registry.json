{
  "schemaVersion": "agentlas.runtime-registry.v1",
  "updatedAt": "2026-09-06",
  "note": "Declarative seed of the runtime x model matrix (PRD 2026-08-15 §3.1). Rows are role-in-invocation, not tool names. `accessPath` answers ONE question only — does this runtime need runtime-specific code (subscription-cli) or the generic API/local path; exact capabilities come from live discovery (ACP session/new, models.dev, probes). `pin` values are what we last verified, not what a machine must have. Live rows are merged over this seed (Orca-style seed + live merge); the seed is never the whole universe.",
  "grades": {
    "A": "hand-coded native stream driver kept (token accounting / latency)",
    "B": "hand-coded driver exists but weak; ACP is the target transport",
    "C": "no driver; ACP is the only integration",
    "D": "no ACP; instruction file + MCP only",
    "E": "excluded (orchestrator/client, or dead upstream)"
  },
  "installLevels": {
    "L0": "portable instruction file only",
    "L1": "instruction file + skills drop",
    "L2": "L1 + Stop hook / observation",
    "L3": "full code mirror + live event hooks"
  },
  "hostAdapters": {
    "note": "The one list of host-adapter source directories, and the name of the bundle they are staged into. Three copies used to restate it by hand — scripts/install-all-runtimes.sh, scripts/build-runtime-release-asset.sh and agentlas_cloud/update.py — and when amp/warp/amazonq were dropped only the last one was updated: the release asset build then handed git archive three paths that no longer exist, and `kimi` was in the installer bundle but never in the release allowlist, so a runtime installed from the tarball had no Kimi adapter. All three now read this list; tests/test_installer_registry_parity.py fails when any of them stops agreeing. `.zcode` was added 2026-09-06: scripts/render-host-commands.py had rendered and kept `.zcode/commands/*.md` in sync with the canonical bodies since it was added, but this list never carried `.zcode`, so those 31 files were built, verified clean by --check, and never reached the release archive or a runtime home. scripts/render-host-commands.py and scripts/render-host-skills.py now check every host directory they render against this list before writing anything.",
    "bundleDir": "host_adapters",
    "dirs": [
      ".agents",
      ".claude",
      ".claude-plugin",
      ".gemini",
      ".zcode",
      "antigravity",
      "claude",
      "codex",
      "copilot-cli",
      "cursor",
      "gemini",
      "goose",
      "grok",
      "hermes",
      "hooks",
      "kimi",
      "openclaw",
      "opencode",
      "skills"
    ]
  },
  "runtimes": [
    {
      "id": "claude-code",
      "installer": "claude",
      "label": "Claude Code",
      "role": "tier1",
      "grade": "A",
      "installLevel": "L3",
      "vendors": [
        "anthropic"
      ],
      "accessPath": "subscription-cli",
      "binary": "claude",
      "configDir": "~/.claude",
      "entrypoint": "~/.claude/CLAUDE.md",
      "hooks": {
        "file": "~/.claude/settings.json",
        "shape": "claude-settings"
      },
      "acp": {
        "source": "adapter",
        "command": "npx",
        "args": [
          "-y",
          "@agentclientprotocol/claude-agent-acp@0.75.1"
        ],
        "registryId": "claude-acp"
      },
      "pin": {
        "registryVersion": "0.75.1"
      },
      "notes": "Native stream-json keeps true input/output tokens; ACP usage_update is context occupancy only. Stays A."
    },
    {
      "id": "codex",
      "installer": "codex",
      "label": "Codex CLI",
