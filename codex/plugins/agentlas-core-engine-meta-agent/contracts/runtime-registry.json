    },
    {
      "id": "goose",
      "label": "Goose",
      "role": "tier1",
      "grade": "C",
      "installLevel": "L2",
      "vendors": ["multi"],
      "accessPath": "subscription-cli",
      "binary": "goose",
      "configDir": "~/.config/goose",
      "entrypoint": null,
      "hooks": {"file": "~/.agents/plugins/agentlas-one", "shape": "hookpack-dir"},
      "acp": {"source": "native", "command": "goose", "args": ["acp"], "registryId": "goose"},
      "pin": {"registryVersion": "1.46.0", "cliVersion": "1.45.0"}
    },
    {
      "id": "github-copilot-cli",
      "label": "GitHub Copilot CLI",
      "role": "tier1",
      "grade": "C",
      "installLevel": "L1",
      "vendors": ["multi"],
      "accessPath": "subscription-cli",
      "binary": "copilot",
      "configDir": "~/.copilot",
      "entrypoint": null,
      "hooks": {"shape": "none"},
      "acp": {"source": "native", "command": "npx", "args": ["-y", "@github/copilot@1.0.80", "--acp"], "registryId": "github-copilot-cli"},
