    },
    {
      "id": "openclaw",
      "label": "OpenClaw",
      "role": "tier1",
      "grade": "D",
      "installLevel": "L2",
      "vendors": ["multi"],
      "accessPath": "subscription-cli",
      "binary": "openclaw",
      "configDir": "~/.openclaw",
      "entrypoint": "~/.openclaw/workspace/AGENTS.md",
      "hooks": {"file": "~/.openclaw/hooks/agentlas-one", "shape": "hookpack-dir"},
      "acp": {"source": "none"},
      "pin": {}
    },
    {
      "id": "hermes",
      "label": "Hermes Agent",
      "role": "tier1",
      "grade": "D",
      "installLevel": "L1",
      "vendors": ["multi"],
      "accessPath": "subscription-cli",
      "binary": "hermes",
      "configDir": "~/.hermes",
      "entrypoint": null,
      "hooks": {"shape": "none"},
      "acp": {"source": "opt-in", "command": "hermes", "args": ["acp"]},
