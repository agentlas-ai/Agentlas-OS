{
  "schemaVersion": "agentlas.runtime-registry.v1",
  "updatedAt": "2026-08-15",
  "note": "Declarative seed of the runtime x model matrix (PRD 2026-08-15 §3.1). Rows are role-in-invocation, not tool names. `accessPath` answers ONE question only — does this runtime need runtime-specific code (subscription-cli) or the generic API/local path; exact capabilities come from live discovery (ACP session/new, models.dev, probes). `pin` values are what we last verified, not what a machine must have. Live rows are merged over this seed (Orca-style seed + live merge); the seed is never the whole universe.",
  "grades": {
    "A": "hand-coded native stream driver kept (token accounting / latency)",
    "B": "hand-coded driver exists but weak; ACP is the target transport",
    "C": "no driver; ACP is the only integration",
    "D": "no ACP; instruction file + MCP only",
    "E": "excluded (orchestrator/client, or dead upstream)"
  },
  "installLevels": {
    "L0": "portable instruction file only",
    "L1": "instruction file + skills drop",
    "L2": "L1 + Stop hook / observation",
    "L3": "full code mirror + live event hooks"
  },
  "runtimes": [
    {
      "id": "claude-code",
      "label": "Claude Code",
      "role": "tier1",
      "grade": "A",
      "installLevel": "L3",
      "vendors": ["anthropic"],
      "accessPath": "subscription-cli",
      "binary": "claude",
      "configDir": "~/.claude",
      "entrypoint": "~/.claude/CLAUDE.md",
      "hooks": {"file": "~/.claude/settings.json", "shape": "claude-settings"},
      "acp": {"source": "adapter", "command": "npx", "args": ["-y", "@agentclientprotocol/claude-agent-acp@0.68.0"], "registryId": "claude-acp"},
      "pin": {"registryVersion": "0.68.0"},
      "notes": "Native stream-json keeps true input/output tokens; ACP usage_update is context occupancy only. Stays A."
    },
    {
      "id": "codex",
      "label": "Codex CLI",
      "role": "tier1",
      "grade": "A",
      "installLevel": "L3",
      "vendors": ["openai"],
      "accessPath": "subscription-cli",
      "binary": "codex",
      "configDir": "~/.codex",
      "entrypoint": "~/.codex/AGENTS.md",
      "hooks": {"file": "~/.codex/hooks.json", "shape": "codex-hooks"},
      "acp": {"source": "adapter", "command": "npx", "args": ["-y", "@agentclientprotocol/codex-acp@1.3.0"], "registryId": "codex-acp"},
      "pin": {"registryVersion": "1.3.0"},
      "notes": "ACP path measured stable (11-13s). Promotion candidate to B when token accounting loss is acceptable."
    },
    {
      "id": "antigravity",
      "label": "Antigravity (agy)",
      "role": "tier1",
      "grade": "D",
      "installLevel": "L1",
      "vendors": ["google", "anthropic", "openai-oss"],
      "accessPath": "subscription-cli",
      "binary": "agy",
      "configDir": "~/.gemini",
      "entrypoint": "~/.gemini/GEMINI.md",
      "hooks": {"file": "~/.gemini/config/hooks.json", "shape": "agy-namemap"},
      "acp": {"source": "none"},
      "pin": {"cliVersion": "1.1.13"},
      "notes": "Multi-vendor proxy (measured: 11 google + 2 anthropic + 1 gpt-oss rows) with the weakest Agentlas integration. `agy models` is tab-separated 2 columns since 1.1.12; rc is 0 even on usage output."
    },
    {
      "id": "gemini",
      "label": "Gemini CLI (enterprise)",
      "role": "tier1",
      "grade": "B",
      "installLevel": "L1",
      "vendors": ["google"],
      "accessPath": "subscription-cli",
      "binary": "gemini",
      "configDir": "~/.gemini",
      "entrypoint": "~/.gemini/GEMINI.md",
      "hooks": {"shape": "none"},
      "acp": {"source": "native", "command": "gemini", "args": ["--acp"], "registryId": "gemini"},
      "pin": {"registryVersion": "0.55.1"},
      "notes": "Individual-tier service ended 2026-06-18; enterprise only. Successor is Antigravity."
    },
    {
      "id": "cursor",
      "label": "Cursor (cursor-agent CLI, spawned as a child)",
      "role": "tier1",
      "grade": "B",
      "installLevel": "L2",
      "vendors": ["anthropic", "openai", "google", "cursor-composer"],
      "accessPath": "subscription-cli",
      "binary": "cursor-agent",
      "configDir": "~/.cursor",
      "entrypoint": null,
      "hooks": {"file": "~/.cursor/hooks.json", "shape": "cursor-flat"},
      "acp": {"source": "native", "command": "cursor-agent", "args": ["acp"], "registryId": "cursor"},
      "pin": {"registryVersion": "2026.08.11"},
      "notes": "Composer has no public API — CLI-only. Hand driver shows no tool calls; ACP fixes that."
    },
    {
      "id": "grok",
      "label": "Grok Build CLI",
      "role": "tier1",
      "grade": "B",
      "installLevel": "L1",
      "vendors": ["xai"],
      "accessPath": "subscription-cli",
      "binary": "grok",
      "configDir": "~/.grok",
      "entrypoint": null,
      "hooks": {"shape": "none"},
      "acp": {"source": "native", "command": "grok", "args": ["agent", "stdio"], "registryId": "grok-build"},
      "pin": {"registryVersion": "1.0.4", "cliVersion": "1.0.3"},
      "notes": "Hand driver classifies tools by guessing `type` strings; ACP normalizes them."
    },
    {
      "id": "kimi",
      "label": "Kimi CLI",
      "role": "tier1",
      "grade": "B",
      "installLevel": "L1",
