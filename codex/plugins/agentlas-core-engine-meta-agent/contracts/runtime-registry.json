{
  "$comment": "prompt-module: {\"id\":\"os.runtime-registry.document\",\"revision\":2,\"stability\":\"versioned-content\",\"changeTriggers\":[\"release\"],\"channel\":\"tool-result\"}",
  "schemaVersion": "agentlas.runtime-registry.v1",
  "updatedAt": "2026-10-10",
  "note": "Declarative seed of the runtime x model matrix. Rows are invocation roles, not tool names. `accessPath` selects runtime-specific subscription CLI code or the generic API/local path; exact capabilities come from live discovery. `pin` values are reference versions, not machine requirements. Live rows are merged over this seed; the seed is not the complete inventory.",
  "grades": {
    "A": "hand-coded native stream driver kept (token accounting / latency)",
    "B": "hand-coded driver exists but weak; ACP is the target transport",
    "C": "no driver; ACP is the only integration",
    "D": "no ACP; instruction file + MCP only",
    "E": "excluded (orchestrator/client, or dead upstream)"
  },
  "installLevels": {
    "L0": "portable instruction file only",
    "L1": "instruction file + skills drop",
    "L2": "L1 + Stop hook / observation",
    "L3": "full code mirror + live event hooks"
  },
  "hostAdapters": {
    "note": "Canonical host-adapter source directories and the bundle they are staged into. Installers, release packaging and runtime updates must use this list and include the declared adapters.",
    "bundleDir": "host_adapters",
    "dirs": [
      ".agents",
      ".claude",
      ".claude-plugin",
      ".zcode",
      "antigravity",
      "claude",
      "codex",
      "copilot-cli",
      "cursor",
      "goose",
      "grok",
      "hermes",
      "hooks",
      "kimi",
      "openclaw",
      "opencode",
      "skills"
    ]
  },
  "runtimes": [
    {
      "id": "claude-code",
      "installer": "claude",
      "label": "Claude Code",
      "role": "tier1",
      "grade": "A",
      "installLevel": "L3",
      "vendors": [
        "anthropic"
      ],
      "accessPath": "subscription-cli",
      "binary": "claude",
      "configDir": "~/.claude",
      "entrypoint": "~/.claude/CLAUDE.md",
      "hooks": {
        "file": "~/.claude/settings.json",
        "shape": "claude-settings"
      },
      "acp": {
        "source": "adapter",
        "command": "npx",
        "args": [
          "-y",
          "@agentclientprotocol/claude-agent-acp@0.89.0"
        ],
        "registryId": "claude-acp"
      },
      "pin": {
        "registryVersion": "0.89.0"
      },
      "notes": "Native stream-json keeps true input/output tokens; ACP usage_update is context occupancy only. Stays A."
    },
    {
      "id": "codex",
      "installer": "codex",
      "label": "Codex CLI",
      "role": "tier1",
      "grade": "A",
      "installLevel": "L3",
      "vendors": [
        "openai"
      ],
      "accessPath": "subscription-cli",
      "binary": "codex",
      "configDir": "~/.codex",
      "entrypoint": "~/.codex/AGENTS.md",
      "hooks": {
        "file": "~/.codex/hooks.json",
        "shape": "codex-hooks"
      },
      "acp": {
        "source": "adapter",
        "command": "npx",
        "args": [
          "-y",
          "@agentclientprotocol/codex-acp@2.1.1"
        ],
        "registryId": "codex-acp"
      },
      "pin": {
        "registryVersion": "2.1.1"
      },
      "notes": "Assess token-accounting compatibility when choosing ACP."
    },
    {
      "id": "antigravity",
      "installer": "antigravity",
      "label": "Antigravity (agy)",
      "role": "tier1",
      "grade": "D",
      "installLevel": "L1",
      "vendors": [
        "google",
        "anthropic",
        "openai-oss"
      ],
      "accessPath": "subscription-cli",
      "binary": "agy",
      "configDir": "~/.gemini",
      "entrypoint": "~/.gemini/GEMINI.md",
      "hooks": {
        "file": "~/.gemini/config/hooks.json",
        "shape": "agy-namemap"
      },
      "acp": {
        "source": "none"
      },
      "pin": {
        "cliVersion": "1.1.13"
      },
      "notes": "Multi-vendor proxy. `agy models` is tab-separated 2 columns since 1.1.12; rc is 0 even on usage output."
    },
    {
      "id": "cursor",
      "installer": "cursor",
      "label": "Cursor (cursor-agent CLI, spawned as a child)",
      "role": "tier1",
