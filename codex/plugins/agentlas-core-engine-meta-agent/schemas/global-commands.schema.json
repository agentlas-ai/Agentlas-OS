{
  "$comment": "prompt-module: {\"id\":\"os.global-commands.schema\",\"revision\":2,\"stability\":\"versioned-content\",\"changeTriggers\":[\"release\"],\"channel\":\"output-schema\"}",
  "schemaVersion": "1.0",
  "title": "Agentlas Global Commands",
  "type": "object",
  "required": [
    "schemaVersion",
    "packageId",
    "canonicalCommand",
    "commands",
    "postCreationUserMessage"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "packageId": {
      "type": "string"
    },
    "canonicalCommand": {
      "type": "string",
      "pattern": "^/[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)?$"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "description": "Command adapters this package exposes. Authors choose how many runtimes to adapt to; the schema accepts the declared compatibility shapes. The full runtime, command, adapterPath, scope and status record remains the canonical generated form.",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "runtime",
              "command",
              "adapterPath",
              "scope",
              "status"
            ],
            "properties": {
              "runtime": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "adapterPath": {
                "type": "string"
              },
              "globalInstallPath": {
                "type": "string"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "global",
                  "project",
                  "plugin",
                  "terminal"
                ]
              },
              "status": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "entry": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "entrypoint": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "runtimeAdapters": {}
            }
          }
        ],
        "$comment": "Use anyOf because accepted entry shapes overlap: a full runtime-adapter entry can also satisfy the minimal command shape. Keep forward-compatible fields allowed."
      }
    },
    "postCreationUserMessage": {
      "type": "object",
      "required": [
        "required",
        "template"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "template": {
          "type": "string"
        }
      }
    }
  }
}
