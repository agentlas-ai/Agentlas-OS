{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlas.ai/schemas/runtime-registry.schema.json",
  "title": "Agentlas Runtime Registry",
  "description": "Declarative seed of runtimes Agentlas knows how to sit inside of or spawn. Rows are role-in-invocation. accessPath answers only 'runtime-specific code or generic path'; capabilities never live here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "runtimes"],
  "properties": {
    "schemaVersion": {"const": "agentlas.runtime-registry.v1"},
    "updatedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "note": {"type": "string"},
    "grades": {"type": "object", "additionalProperties": {"type": "string"}},
    "installLevels": {"type": "object", "additionalProperties": {"type": "string"}},
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "role", "grade", "installLevel", "vendors", "accessPath", "hooks", "acp", "pin"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 120},
          "role": {"enum": ["tier1", "tier0", "model-server"]},
          "grade": {"enum": ["A", "B", "C", "D", "E"]},
          "installLevel": {"enum": ["L0", "L1", "L2", "L3"]},
          "vendors": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "accessPath": {"enum": ["subscription-cli", "api", "local", "unknown"]},
          "binary": {"type": ["string", "null"]},
          "configDir": {"type": ["string", "null"]},
          "entrypoint": {"type": ["string", "null"]},
          "hooks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shape"],
            "properties": {
              "file": {"type": "string"},
              "shape": {"enum": ["claude-settings", "codex-hooks", "cursor-flat", "agy-namemap", "hookpack-dir", "none"]}
            }
          },
          "acp": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source"],
            "properties": {
              "source": {"enum": ["native", "adapter", "opt-in", "client", "none"]},
              "command": {"type": "string"},
              "args": {"type": "array", "items": {"type": "string"}},
              "registryId": {"type": "string"}
            }
          },
          "pin": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "registryVersion": {"type": "string"},
              "cliVersion": {"type": "string"}
            }
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
