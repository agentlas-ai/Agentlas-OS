{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlas.dev/schemas/sitemap.schema.json",
  "title": "Agentlas Functional AI Sitemap",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "relative_path": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "generated": {
            "type": "boolean"
          },
          "codeFiles": {
            "type": "integer",
            "minimum": 0
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "type"
            ]
          },
          {
            "required": [
              "kind"
            ]
          }
        ],
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "generated": {
            "type": "boolean"
          },
          "weight": {
            "type": "number"
          }
        },
        "anyOf": [
          {
            "required": [
              "type"
            ]
          },
          {
            "required": [
              "relation"
            ]
          },
          {
            "required": [
              "reason"
            ]
          }
        ],
        "additionalProperties": true
      }
    },
    "taskBiases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conceptCoverage": {
      "description": "Measured live: 31 packages ship a list, 1 ships an object. Both are real.",
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        }
      ]
    },
    "functionalProjection": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
