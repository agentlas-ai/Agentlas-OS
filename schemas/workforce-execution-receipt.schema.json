{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlas.ai/schemas/workforce-execution-receipt.schema.json",
  "title": "Agentlas Workforce Direct and Nested Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "executionId", "workOrderId", "selectionReceiptId",
    "preparationReceiptId", "executionContextDigest", "orchestrator", "planner",
    "capabilityBindingPlan",
    "workers", "nestedExecutions", "synthesis", "verifier", "status"
  ],
  "properties": {
    "schemaVersion": { "const": "agentlas.workforce-execution-receipt.v2" },
    "executionId": { "$ref": "#/$defs/id" },
    "workOrderId": { "$ref": "#/$defs/id" },
    "selectionReceiptId": { "$ref": "#/$defs/id" },
    "preparationReceiptId": { "$ref": "#/$defs/id" },
    "executionContextDigest": { "$ref": "#/$defs/hash" },
    "orchestrator": { "$ref": "#/$defs/invocation" },
    "planner": { "$ref": "#/$defs/plannerInvocation" },
    "capabilityBindingPlan": { "$ref": "#/$defs/capabilityBindingPlan" },
    "workers": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": { "$ref": "#/$defs/rosterExecution" }
    },
    "nestedExecutions": {
      "type": "array", "maxItems": 64,
      "items": { "$ref": "#/$defs/nestedExecution" }
    },
    "synthesis": { "$ref": "#/$defs/invocation" },
    "verifier": { "$ref": "#/$defs/verifierInvocation" },
    "status": { "enum": ["passed", "failed", "blocked"] }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{1,255}$"
    },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "toolId": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.$:/@+~-]{0,127}$"
    },
    "ids": {
      "type": "array", "maxItems": 256, "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "effort": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9-]{0,23}$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "invocationProperties": {
      "type": "object",
      "required": [
        "invocationId", "modelId", "runtimeId", "provider", "requestedEffort",
        "appliedEffort", "effortEvidence", "status"
      ],
      "properties": {
        "invocationId": { "$ref": "#/$defs/id" },
        "modelId": { "$ref": "#/$defs/id" },
        "runtimeId": { "$ref": "#/$defs/id" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "enum": ["orchestrator", "worker"] },
        "requestedEffort": { "$ref": "#/$defs/effort" },
        "appliedEffort": { "$ref": "#/$defs/effort" },
        "effortEvidence": { "enum": ["runner-reported", "runtime-fixed", "not-observable"] },
        "status": { "enum": ["completed", "failed", "blocked"] },
        "usage": { "$ref": "#/$defs/usage" },
        "handoffContractRetry": {
          "enum": ["tool_markup", "empty_deliverable"]
        },
        "reasonCodes": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "escalatedFromRole": { "const": "worker" },
        "failureCount": { "const": 2 },
        "escalationAttempt": { "const": 1 }
      },
      "allOf": [{
        "if": {
          "anyOf": [
            { "required": ["escalatedFromRole"] },
            { "required": ["failureCount"] },
            { "required": ["escalationAttempt"] },
            {
              "required": ["reasonCodes"],
              "properties": {
                "reasonCodes": {
                  "contains": { "const": "escalated-after-failure" }
                }
              }
            }
          ]
        },
        "then": {
          "required": [
            "role", "reasonCodes", "escalatedFromRole",
            "failureCount", "escalationAttempt"
          ],
          "properties": {
            "role": { "const": "orchestrator" },
            "reasonCodes": { "contains": { "const": "escalated-after-failure" } }
          }
        }
      }]
    },
    "effortRules": {
      "allOf": [
        {
          "if": { "properties": { "effortEvidence": { "const": "not-observable" } } },
          "then": { "properties": { "appliedEffort": { "type": "null" } } }
        },
        {
          "if": { "properties": { "effortEvidence": { "const": "runtime-fixed" } } },
          "then": {
            "properties": {
              "requestedEffort": { "type": "null" },
              "appliedEffort": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "effortEvidence": { "const": "runner-reported" } } },
          "then": { "properties": { "appliedEffort": { "type": "string" } } }
        }
      ]
    },
    "invocation": {
      "allOf": [{ "$ref": "#/$defs/invocationProperties" }, { "$ref": "#/$defs/effortRules" }],
      "unevaluatedProperties": false
    },
    "plannerInvocation": {
      "allOf": [
        { "$ref": "#/$defs/invocationProperties" },
        { "$ref": "#/$defs/effortRules" },
        {
          "type": "object",
          "required": [
            "parseSuccess", "fallbackUsed", "toolInventoryDigest",
            "capabilityBindingPlanDigest"
          ],
          "properties": {
            "parseSuccess": { "type": "boolean" },
            "fallbackUsed": { "type": "boolean" },
            "toolInventoryDigest": { "$ref": "#/$defs/hash" },
            "capabilityBindingPlanDigest": { "$ref": "#/$defs/hash" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "verifierInvocation": {
      "allOf": [
        { "$ref": "#/$defs/invocationProperties" },
        { "$ref": "#/$defs/effortRules" },
        {
          "type": "object", "required": ["verdict"],
          "properties": { "verdict": { "enum": ["pass", "fail"] } }
        }
      ],
      "unevaluatedProperties": false
    },
    "capabilityBindingPlan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schemaVersion", "decisionOwner", "plannerInvocationId",
        "executionContextDigest", "toolInventoryDigest", "inventory",
        "bindingPlanDigest"
      ],
      "properties": {
        "schemaVersion": { "const": "agentlas.workforce-capability-binding-plan.v1" },
        "decisionOwner": { "const": "host_llm" },
        "plannerInvocationId": { "$ref": "#/$defs/id" },
        "executionContextDigest": { "$ref": "#/$defs/hash" },
        "toolInventoryDigest": { "$ref": "#/$defs/hash" },
        "inventory": {
          "type": "array", "maxItems": 256,
          "items": { "$ref": "#/$defs/boundCapabilityRow" }
        },
        "bindingPlanDigest": { "$ref": "#/$defs/hash" }
      }
    },
    "boundCapabilityRow": {
      "type": "object", "additionalProperties": false,
      "required": [
        "slotId", "agentReleaseId", "permissionPolicyDigest", "toolId",
        "provider", "capabilityIds", "status"
      ],
      "properties": {
        "slotId": { "$ref": "#/$defs/id" },
        "agentReleaseId": { "$ref": "#/$defs/id" },
        "permissionPolicyDigest": { "$ref": "#/$defs/hash" },
        "toolId": { "$ref": "#/$defs/toolId" },
        "provider": { "enum": ["builtin", "mcp"] },
        "capabilityIds": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "uniqueItems": true, "items": { "$ref": "#/$defs/id" }
        },
        "status": { "const": "bound" }
      }
    },
    "hostInventorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolIds",
        "connectedServers",
        "serverStates",
        "selectedBindings",
        "selectedServers",
        "inventoryDigest",
        "selectedBindingDigest"
      ],
      "properties": {
        "toolIds": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/toolId"
          }
        },
        "connectedServers": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/toolId"
          }
        },
        "serverStates": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "runtimeStatus",
              "toolsDigest",
              "serverInfoDigest",
              "toolsError"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/toolId"
              },
              "runtimeStatus": {
                "enum": [
                  "notStarted",
                  "starting",
                  "connected",
                  "authenticationRequired",
                  "failed",
                  "cancelled",
                  "disabled"
                ]
              },
              "toolsDigest": {
                "$ref": "#/$defs/hash"
              },
              "serverInfoDigest": {
                "$ref": "#/$defs/hash"
              },
              "toolsError": {
                "type": "boolean"
              }
            }
          }
        },
        "selectedBindings": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "toolId",
              "serverName",
              "descriptorDigest"
            ],
            "properties": {
              "toolId": {
                "$ref": "#/$defs/toolId"
              },
              "serverName": {
                "$ref": "#/$defs/toolId"
              },
              "descriptorDigest": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        },
        "selectedServers": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "serverInfoDigest"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/toolId"
              },
              "serverInfoDigest": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        },
        "inventoryDigest": {
          "$ref": "#/$defs/hash"
        },
        "selectedBindingDigest": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "hostInventoryObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "stability",
        "before",
        "after"
      ],
      "properties": {
        "schemaVersion": {
          "const": "agentlas.workforce-host-inventory-observation.v1"
        },
        "stability": {
          "const": "selected-grant-bindings"
        },
        "before": {
          "$ref": "#/$defs/hostInventorySnapshot"
        },
        "after": {
          "$ref": "#/$defs/hostInventorySnapshot"
        }
      }
    },
    "hostObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "permissionPolicyDigest",
        "toolInventoryDigest",
        "runtimeKind",
        "runtimeVersion",
        "sessionId",
        "turnId",
        "nativePolicy",
        "toolIds",
        "connectedServers",
        "approvalEvents",
        "completed",
        "inventoryScope",
        "nativeToolsEnumerated",
        "requestedConfigDigest",
        "observationDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "agentlas.workforce-host-observation.v1"
        },
        "permissionPolicyDigest": {
          "$ref": "#/$defs/hash"
        },
        "toolInventoryDigest": {
          "$ref": "#/$defs/hash"
        },
        "runtimeKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runtimeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "turnId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativePolicy": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32
        },
        "toolIds": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.$:/@+~-]{0,127}$"
          }
        },
        "connectedServers": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.$:/@+~-]{0,127}$"
          }
        },
        "approvalEvents": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requestId",
              "decision"
            ],
            "properties": {
              "requestId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "decision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        "completed": {
          "const": true
        },
        "inventoryScope": {
          "enum": [
            "connected-mcp-tools",
            "native-init-tools"
          ]
        },
        "nativeToolsEnumerated": {
          "type": "boolean"
        },
        "requestedConfigDigest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hash"
            }
          ]
        },
        "inventoryEvidence": {
          "$ref": "#/$defs/hostInventoryObservation"
        },
        "observationDigest": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "brokerObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "brokerKind",
        "brokerInvocationId",
        "runtimeKind",
        "permissionPolicyDigest",
        "toolInventoryDigest",
        "permission",
        "cwd",
        "requestedConfigDigest",
        "inventory",
        "inventoryDigest",
        "actions",
        "completed",
        "observationDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "agentlas.workforce-broker-observation.v1"
        },
        "brokerKind": {
          "const": "agentlas-main-tool-loop"
        },
        "brokerInvocationId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "runtimeKind": {
          "$ref": "#/$defs/id"
        },
        "permissionPolicyDigest": {
          "$ref": "#/$defs/hash"
        },
        "toolInventoryDigest": {
          "$ref": "#/$defs/hash"
        },
        "permission": {
          "enum": [
            "read",
            "write",
            "full"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096
        },
        "requestedConfigDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "inventory": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "toolId",
              "kind",
              "descriptorDigest",
              "serverConfigKey",
              "serverConfigDigest"
            ],
            "properties": {
              "toolId": {
                "$ref": "#/$defs/toolId"
              },
              "kind": {
                "enum": [
                  "builtin",
                  "mcp"
                ]
              },
              "descriptorDigest": {
                "$ref": "#/$defs/hash"
              },
              "serverConfigKey": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/toolId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "serverConfigDigest": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/hash"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "builtin"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "serverConfigKey": {
                      "type": "null"
                    },
                    "serverConfigDigest": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "serverConfigKey": {
                      "$ref": "#/$defs/toolId"
                    },
                    "serverConfigDigest": {
                      "$ref": "#/$defs/hash"
                    }
                  }
                }
              }
            ]
          }
        },
        "inventoryDigest": {
          "$ref": "#/$defs/hash"
        },
        "actions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actionId",
              "providerCallId",
              "providerCallLocation",
              "toolId",
              "decision",
              "outcome"
            ],
            "properties": {
              "actionId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "providerCallId": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "toolId": {
                "$ref": "#/$defs/toolId"
              },
              "decision": {
                "enum": [
                  "not_requested",
                  "allow_once",
                  "allow_session",
                  "deny"
                ]
              },
              "outcome": {
                "enum": [
                  "succeeded",
                  "failed",
                  "denied",
                  "not_dispatched"
                ]
              },
              "providerCallLocation": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "responseIndex",
                  "partIndex"
                ],
                "properties": {
                  "responseIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4095
                  },
                  "partIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4095
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "enum": [
                        "succeeded",
                        "failed"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "decision": {
                      "enum": [
                        "allow_once",
                        "allow_session"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "enum": [
                        "denied"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "decision": {
                      "enum": [
                        "deny"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "enum": [
                        "not_dispatched"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "decision": {
                      "enum": [
                        "not_requested"
                      ]
                    }
                  }
                }
              }
            ],
            "anyOf": [
              {
                "properties": {
                  "providerCallId": {
                    "type": "string"
                  }
                }
              },
              {
                "properties": {
                  "providerCallLocation": {
                    "type": "object"
                  }
                }
              }
            ]
          }
        },
        "completed": {
          "const": true
        },
        "observationDigest": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "permissionEnforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permissionPolicyDigest",
        "enforcementMode",
        "status",
        "approvalReceiptIds",
        "enforcementEvidence"
      ],
      "properties": {
        "permissionPolicyDigest": {
          "$ref": "#/$defs/hash"
        },
        "enforcementMode": {
          "enum": [
            "native-sandbox",
            "no-authority-sandbox",
            "zero-tools",
            "host-native",
            "host-broker"
          ]
        },
        "status": {
          "const": "enforced"
        },
        "enforcementEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtimeKind",
            "runtimeVersion",
            "sandboxMode",
            "toolInventory",
            "disabledCapabilities",
            "ephemeral",
            "ignoredUserConfig",
            "ignoredRules",
            "toolInventoryDigest",
            "grantedToolIds"
          ],
          "properties": {
            "runtimeKind": {
              "$ref": "#/$defs/id"
            },
            "runtimeVersion": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 100
            },
            "sandboxMode": {
              "enum": [
                "read-only",
                "no-filesystem",
                "host-native",
                "not-applicable",
                "host-broker"
              ]
            },
            "toolInventory": {
              "enum": [
                "empty",
                "non-authoritative",
                "policy-filtered",
                "host-observed",
                "broker-observed"
              ]
            },
            "disabledCapabilities": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "ephemeral": {
              "type": "boolean"
            },
            "ignoredUserConfig": {
              "type": "boolean"
            },
            "ignoredRules": {
              "type": "boolean"
            },
            "toolInventoryDigest": {
              "$ref": "#/$defs/hash"
            },
            "grantedToolIds": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/toolId"
              }
            },
            "hostObservation": {
              "$ref": "#/$defs/hostObservation"
            },
            "brokerObservation": {
              "$ref": "#/$defs/brokerObservation"
            }
          }
        },
        "approvalReceiptIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enforcementMode": {
                "enum": [
                  "no-authority-sandbox",
                  "zero-tools"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "approvalReceiptIds": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enforcementMode": {
                "const": "zero-tools"
              }
            }
          },
          "then": {
            "properties": {
              "enforcementEvidence": {
                "properties": {
                  "toolInventory": {
                    "const": "empty"
                  },
                  "grantedToolIds": {
                    "maxItems": 0
                  },
                  "ephemeral": {
                    "const": true
                  },
                  "ignoredUserConfig": {
                    "const": true
                  },
                  "ignoredRules": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enforcementMode": {
                "const": "no-authority-sandbox"
              }
            }
          },
          "then": {
            "properties": {
              "enforcementEvidence": {
                "properties": {
                  "sandboxMode": {
                    "enum": [
                      "read-only",
                      "no-filesystem"
                    ]
                  },
                  "toolInventory": {
                    "enum": [
                      "empty",
                      "non-authoritative"
                    ]
                  },
                  "disabledCapabilities": {
                    "minItems": 1
                  },
                  "grantedToolIds": {
                    "maxItems": 0
                  },
                  "ephemeral": {
                    "const": true
                  },
                  "ignoredUserConfig": {
                    "const": true
                  },
                  "ignoredRules": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enforcementMode": {
                "const": "native-sandbox"
              }
            }
          },
          "then": {
            "properties": {
              "enforcementEvidence": {
                "properties": {
                  "toolInventory": {
                    "const": "policy-filtered"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enforcementMode": {
                "const": "host-native"
              }
            }
          },
          "then": {
            "properties": {
              "enforcementEvidence": {
                "required": [
                  "hostObservation"
                ],
                "properties": {
                  "sandboxMode": {
                    "const": "host-native"
                  },
                  "toolInventory": {
                    "const": "host-observed"
                  },
                  "ephemeral": {
                    "const": false
                  },
                  "ignoredUserConfig": {
                    "const": false
                  },
                  "ignoredRules": {
                    "const": false
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "enforcementEvidence": {
                "not": {
                  "required": [
                    "hostObservation"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enforcementMode": {
                "const": "host-broker"
              }
            }
          },
          "then": {
            "properties": {
              "enforcementEvidence": {
                "required": [
                  "brokerObservation"
                ],
                "properties": {
                  "runtimeVersion": {
                    "type": "null"
                  },
                  "sandboxMode": {
                    "const": "host-broker"
                  },
                  "toolInventory": {
                    "const": "broker-observed"
                  },
                  "disabledCapabilities": {
                    "maxItems": 0
                  },
                  "ephemeral": {
                    "const": false
                  },
                  "ignoredUserConfig": {
                    "const": false
                  },
                  "ignoredRules": {
                    "const": false
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "enforcementEvidence": {
                "not": {
                  "required": [
                    "brokerObservation"
                  ]
                },
                "properties": {
                  "sandboxMode": {
                    "not": {
                      "const": "host-broker"
                    }
                  },
                  "toolInventory": {
                    "not": {
                      "const": "broker-observed"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "permissionInvocationProperties": {
      "type": "object", "required": ["permissionEnforcement"],
      "properties": { "permissionEnforcement": { "$ref": "#/$defs/permissionEnforcement" } }
    },
    "permissionInvocation": {
      "allOf": [
        { "$ref": "#/$defs/invocationProperties" },
        { "$ref": "#/$defs/effortRules" },
        { "$ref": "#/$defs/permissionInvocationProperties" }
      ],
      "unevaluatedProperties": false
    },
    "managerPlanInvocation": {
      "allOf": [
        { "$ref": "#/$defs/invocationProperties" },
        { "$ref": "#/$defs/effortRules" },
        { "$ref": "#/$defs/permissionInvocationProperties" },
        {
          "type": "object",
          "required": ["parseSuccess", "fallbackUsed", "plannedWorkerIds"],
          "properties": {
            "parseSuccess": { "type": "boolean" },
            "fallbackUsed": { "type": "boolean" },
            "plannedWorkerIds": { "$ref": "#/$defs/ids" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "nestedWorkerInvocation": {
      "allOf": [
        { "$ref": "#/$defs/invocationProperties" },
        { "$ref": "#/$defs/effortRules" },
        { "$ref": "#/$defs/permissionInvocationProperties" },
        {
          "type": "object", "required": ["id"],
          "properties": { "id": { "$ref": "#/$defs/id" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "rosterExecution": {
      "type": "object", "additionalProperties": false,
      "required": [
        "slotId", "agentReleaseId", "entityKind", "packageHash", "contentDigest",
        "bundleDigest", "permissionPolicyDigest", "executionGraphDigest", "status",
        "handoffArtifactRefs", "capabilityBindingPlanDigest", "capabilityBindings",
        "executionMode", "directInvocation",
        "nestedExecutionId"
      ],
      "properties": {
        "slotId": { "$ref": "#/$defs/id" },
        "agentReleaseId": { "$ref": "#/$defs/id" },
        "entityKind": { "enum": ["agent", "team"] },
        "packageHash": { "$ref": "#/$defs/hash" },
        "contentDigest": { "$ref": "#/$defs/hash" },
        "bundleDigest": { "$ref": "#/$defs/hash" },
        "permissionPolicyDigest": { "$ref": "#/$defs/hash" },
        "executionGraphDigest": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "status": { "enum": ["completed", "failed", "blocked"] },
        "handoffArtifactRefs": {
          "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "capabilityBindingPlanDigest": { "$ref": "#/$defs/hash" },
        "capabilityBindings": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["capabilityId", "provider", "toolId", "source", "status"],
            "properties": {
              "capabilityId": { "$ref": "#/$defs/id" },
              "provider": { "enum": ["builtin", "mcp"] },
              "toolId": { "$ref": "#/$defs/toolId" },
              "source": { "const": "host_inventory" },
              "status": { "const": "bound" }
            }
          }
        },
        "executionMode": { "enum": ["direct", "nested"] },
        "directInvocation": {
          "oneOf": [{ "$ref": "#/$defs/permissionInvocation" }, { "type": "null" }]
        },
        "priorInvocations": {
          "type": "array", "minItems": 1, "maxItems": 2,
          "items": { "$ref": "#/$defs/permissionInvocation" }
        },
        "nestedExecutionId": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        }
      },
      "oneOf": [
        {
          "properties": {
            "entityKind": { "const": "agent" },
            "executionMode": { "const": "direct" },
            "executionGraphDigest": { "type": "null" },
            "directInvocation": { "$ref": "#/$defs/permissionInvocation" },
            "priorInvocations": {
              "type": "array", "minItems": 1, "maxItems": 2,
              "items": { "$ref": "#/$defs/permissionInvocation" }
            },
            "nestedExecutionId": { "type": "null" }
          }
        },
        {
          "properties": {
            "entityKind": { "const": "team" },
            "executionMode": { "const": "nested" },
            "executionGraphDigest": { "$ref": "#/$defs/hash" },
            "directInvocation": { "type": "null" },
            "priorInvocations": { "maxItems": 0 },
            "nestedExecutionId": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "nestedExecution": {
      "type": "object", "additionalProperties": false,
      "required": [
        "nestedExecutionId", "slotId", "agentReleaseId", "bundleDigest",
        "permissionPolicyDigest", "executionGraphDigest", "managerPlan", "workers",
        "managerSynthesis", "status"
      ],
      "properties": {
        "nestedExecutionId": { "$ref": "#/$defs/id" },
        "slotId": { "$ref": "#/$defs/id" },
        "agentReleaseId": { "$ref": "#/$defs/id" },
        "bundleDigest": { "$ref": "#/$defs/hash" },
        "permissionPolicyDigest": { "$ref": "#/$defs/hash" },
        "executionGraphDigest": { "$ref": "#/$defs/hash" },
        "managerPlan": { "$ref": "#/$defs/managerPlanInvocation" },
        "workers": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": { "$ref": "#/$defs/nestedWorkerInvocation" }
        },
        "managerSynthesis": { "$ref": "#/$defs/permissionInvocation" },
        "status": { "enum": ["completed", "failed", "blocked"] }
      }
    }
  }
}
